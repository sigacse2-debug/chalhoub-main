{% doc %}
  @prompt
    Chalhoub Product Carousel.
    Premium product carousel with customizable heading and collection,
    responsive product cards, AJAX add-to-cart modal, live cart count,
    product options links, carousel arrows, and mobile pagination.
{% enddoc %}

{% assign chalhoub_id = block.id | replace: '_', '' | downcase %}
{% assign chalhoub_collection = block.settings.collection %}

{% style %}
  .chalhoub-carousel-{{ chalhoub_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #111;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
    margin-top
  }

  .chalhoub-carousel-{{ chalhoub_id }}__heading {
    margin: 0;
    font-size: clamp(24px, 3vw, 38px);
    line-height: 1.1;
    font-weight: 700;
    text-transform: uppercase;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__view-all {
    flex-shrink: 0;
    border: 1px solid #777;
    padding: 8px 12px;
    color: #111;
    background: transparent;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: .06em;
    line-height: 1.2;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__stage {
    position: relative;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__track {
    display: grid;
    grid-auto-columns: calc((100% - 60px) / 4);
    grid-auto-flow: column;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 2px 2px 6px;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__track::-webkit-scrollbar {
    display: none;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 100%;
    scroll-snap-align: start;
    background: #fff;
    border: 1px solid #e5e5e5;
    box-shadow: 0 2px 8px rgba(0, 0, 0, .06);
  }

  .chalhoub-carousel-{{ chalhoub_id }}__media {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 14px 14px 12px;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #fff;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__placeholder {
    width: 100%;
    height: 100%;
    background: #f5f5f5;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__info {
    padding: 0 14px 14px;
    text-align: center;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__title {
    display: block;
    margin: 0 0 7px;
    color: #111;
    font-size: 15px;
    line-height: 1.35;
    font-weight: 700;
    text-decoration: none;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__price {
    margin: 0;
    color: #555;
    font-size: 13px;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__action {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    margin-top: auto;
    padding: 12px;
    border: 0;
    border-radius: 0;
    background: #000;
    color: #fff;
    text-align: center;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: .06em;
    font-weight: 600;
    cursor: pointer;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__action:disabled {
    opacity: .6;
    cursor: not-allowed;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__action:focus-visible,
  .chalhoub-carousel-{{ chalhoub_id }}__arrow:focus-visible,
  .chalhoub-carousel-{{ chalhoub_id }}__view-all:focus-visible {
    outline: 2px solid #111;
    outline-offset: 3px;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__arrow {
    position: absolute;
    z-index: 2;
    top: 35%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 42px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #222;
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__arrow--prev {
    right: calc(100% + 5px);
  }

  .chalhoub-carousel-{{ chalhoub_id }}__arrow--next {
    left: calc(100% + 5px);
  }

  .chalhoub-carousel-{{ chalhoub_id }}__dots {
    display: none;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__modal[hidden] {
    display: none !important;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 0, 0, .55);
  }

  .chalhoub-carousel-{{ chalhoub_id }}__dialog {
    position: relative;
    width: min(440px, 100%);
    padding: 28px;
    background: #fff;
    color: #111;
    text-align: center;
    box-shadow: 0 8px 32px rgba(0, 0, 0, .2);
  }

  .chalhoub-carousel-{{ chalhoub_id }}__close {
    position: absolute;
    top: 8px;
    right: 10px;
    padding: 6px;
    border: 0;
    background: transparent;
    color: #111;
    font-size: 24px;
    cursor: pointer;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__modal-image {
    width: 100px;
    height: 100px;
    object-fit: contain;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__modal-title {
    margin: 12px 0 6px;
    font-weight: 700;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__modal-price {
    margin: 0 0 12px;
    color: #555;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__cart-summary {
    margin: 0 0 20px;
    font-size: 14px;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__modal-actions {
    display: flex;
    gap: 10px;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__modal-actions a,
  .chalhoub-carousel-{{ chalhoub_id }}__modal-actions button {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px;
    border: 1px solid #111;
    background: #fff;
    color: #111;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .04em;
    cursor: pointer;
  }

  .chalhoub-carousel-{{ chalhoub_id }}__modal-actions a:last-child {
    background: #000;
    color: #fff;
  }

  @media (max-width: 749px) {
    .chalhoub-carousel-{{ chalhoub_id }} {
      width: 100%;
    }

    .chalhoub-carousel-{{ chalhoub_id }}__header {
      margin-bottom: 16px;
    }

    .chalhoub-carousel-{{ chalhoub_id }}__heading {
      font-size: 24px;
    }

    .chalhoub-carousel-{{ chalhoub_id }}__track {
      grid-auto-columns: 80%;
      gap: 12px;
    }

    .chalhoub-carousel-{{ chalhoub_id }}__arrow {
      display: none;
    }

    .chalhoub-carousel-{{ chalhoub_id }}__dots {
      display: flex;
      justify-content: center;
      gap: 7px;
      margin-top: 14px;
    }

    .chalhoub-carousel-{{ chalhoub_id }}__dot {
      width: 7px;
      height: 7px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: #c8c8c8;
      cursor: pointer;
    }

    .chalhoub-carousel-{{ chalhoub_id }}__dot[aria-current="true"] {
      background: #111;
    }
  }
{% endstyle %}

<chalhoub-product-carousel-{{ chalhoub_id }}
  class="chalhoub-carousel-{{ chalhoub_id }}"
  {{ block.shopify_attributes }}
>
  <div class="chalhoub-carousel-{{ chalhoub_id }}__header">
    <h2 class="chalhoub-carousel-{{ chalhoub_id }}__heading">
      {{ block.settings.title | escape }}
    </h2>

    {% if chalhoub_collection != blank %}
      <a
        class="chalhoub-carousel-{{ chalhoub_id }}__view-all"
        href="{{ chalhoub_collection.url }}"
      >
        {{ block.settings.view_all_label | escape }}
      </a>
    {% endif %}
  </div>

  {% if chalhoub_collection != blank %}
    <div class="chalhoub-carousel-{{ chalhoub_id }}__stage">
      <button
        class="chalhoub-carousel-{{ chalhoub_id }}__arrow chalhoub-carousel-{{ chalhoub_id }}__arrow--prev"
        type="button"
        aria-label="Previous products"
      >‹</button>

      <div
        class="chalhoub-carousel-{{ chalhoub_id }}__track"
        aria-label="{{ block.settings.title | escape }} products"
        tabindex="0"
      >
        {% for product in chalhoub_collection.products limit: block.settings.product_limit %}
          <article class="chalhoub-carousel-{{ chalhoub_id }}__card">
            <a
              class="chalhoub-carousel-{{ chalhoub_id }}__media"
              href="{{ product.url }}"
              aria-label="{{ product.title | escape }}"
            >
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 700 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {% else %}
                <div class="chalhoub-carousel-{{ chalhoub_id }}__placeholder">
                  {{ 'product-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>

            <div class="chalhoub-carousel-{{ chalhoub_id }}__info">
              <a
                class="chalhoub-carousel-{{ chalhoub_id }}__title"
                href="{{ product.url }}"
              >
                {{ product.title | escape }}
              </a>

              <p class="chalhoub-carousel-{{ chalhoub_id }}__price">
                {{ product.price | money }}
              </p>
            </div>

            {% if product.has_only_default_variant %}
              <button
                class="chalhoub-carousel-{{ chalhoub_id }}__action"
                type="button"
                data-add-to-cart
                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                data-title="{{ product.title | escape }}"
                data-price="{{ product.price | money | escape }}"
                data-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 240 }}{% endif %}"
                {% unless product.available %}disabled{% endunless %}
              >
                {% if product.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
              </button>
            {% else %}
              <a
                class="chalhoub-carousel-{{ chalhoub_id }}__action"
                href="{{ product.url }}"
              >
                SELECT OPTIONS
              </a>
            {% endif %}
          </article>
        {% else %}
          <p>No products found in this collection.</p>
        {% endfor %}
      </div>

      <button
        class="chalhoub-carousel-{{ chalhoub_id }}__arrow chalhoub-carousel-{{ chalhoub_id }}__arrow--next"
        type="button"
        aria-label="Next products"
      >›</button>
    </div>

    <div
      class="chalhoub-carousel-{{ chalhoub_id }}__dots"
      aria-label="Carousel pagination"
    ></div>
  {% else %}
    <p>Choose a collection to show products.</p>
  {% endif %}

  <div class="chalhoub-carousel-{{ chalhoub_id }}__modal" data-modal hidden>
    <div
      class="chalhoub-carousel-{{ chalhoub_id }}__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="chalhoub-modal-title-{{ chalhoub_id }}"
      tabindex="-1"
    >
      <button
        class="chalhoub-carousel-{{ chalhoub_id }}__close"
        type="button"
        aria-label="Close"
      >×</button>

      <img
        class="chalhoub-carousel-{{ chalhoub_id }}__modal-image"
        data-modal-image
        alt=""
        hidden
      >

      <h3
        class="chalhoub-carousel-{{ chalhoub_id }}__modal-title"
        id="chalhoub-modal-title-{{ chalhoub_id }}"
        data-modal-title
      ></h3>

      <p
        class="chalhoub-carousel-{{ chalhoub_id }}__modal-price"
        data-modal-price
      ></p>

      <p
        class="chalhoub-carousel-{{ chalhoub_id }}__cart-summary"
        data-cart-summary
        aria-live="polite"
      ></p>

      <div class="chalhoub-carousel-{{ chalhoub_id }}__modal-actions">
        <button type="button" data-continue>CONTINUE SHOPPING</button>
        <a href="{{ routes.cart_url }}">GO TO CART</a>
      </div>
    </div>
  </div>
</chalhoub-product-carousel-{{ chalhoub_id }}>

<script>
(function () {
  const tagName = 'chalhoub-product-carousel-{{ chalhoub_id }}';

  if (customElements.get(tagName)) return;

  class ChalhoubProductCarousel extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector(
        '.chalhoub-carousel-{{ chalhoub_id }}__track'
      );

      this.modal = this.querySelector('[data-modal]');

      if (this.track) {
        const previous = this.querySelector(
          '.chalhoub-carousel-{{ chalhoub_id }}__arrow--prev'
        );

        const next = this.querySelector(
          '.chalhoub-carousel-{{ chalhoub_id }}__arrow--next'
        );

        previous?.addEventListener('click', () => this.scroll(-1));
        next?.addEventListener('click', () => this.scroll(1));

        this.makeDots();

        this.track.addEventListener(
          'scroll',
          () => this.updateDots(),
          { passive: true }
        );
      }

      this.querySelectorAll('[data-add-to-cart]').forEach((button) => {
        button.addEventListener('click', () => this.addItem(button));
      });

      this.querySelector(
        '.chalhoub-carousel-{{ chalhoub_id }}__close'
      )?.addEventListener('click', () => this.closeModal());

      this.querySelector('[data-continue]')?.addEventListener(
        'click',
        () => this.closeModal()
      );

      this.modal?.addEventListener('click', (event) => {
        if (event.target === this.modal) this.closeModal();
      });

      this.onKeydown = (event) => {
        if (event.key === 'Escape' && this.modal && !this.modal.hidden) {
          this.closeModal();
        }
      };

      document.addEventListener('keydown', this.onKeydown);
    }

    disconnectedCallback() {
      if (this.onKeydown) {
        document.removeEventListener('keydown', this.onKeydown);
      }
    }

    scroll(direction) {
      const firstCard = this.track?.querySelector('article');
      if (!firstCard) return;

      const styles = getComputedStyle(this.track);
      const gap = parseFloat(styles.columnGap) || 0;
      const distance = firstCard.getBoundingClientRect().width + gap;

      this.track.scrollBy({
        left: direction * distance,
        behavior: 'smooth'
      });
    }

    makeDots() {
      const dots = this.querySelector(
        '.chalhoub-carousel-{{ chalhoub_id }}__dots'
      );

      if (!dots || !this.track) return;

      dots.replaceChildren();

      this.track.querySelectorAll('article').forEach((card, index) => {
        const dot = document.createElement('button');

        dot.type = 'button';
        dot.className = 'chalhoub-carousel-{{ chalhoub_id }}__dot';
        dot.setAttribute('aria-label', 'Go to product ' + (index + 1));
        dot.setAttribute('aria-current', index === 0 ? 'true' : 'false');

        dot.addEventListener('click', () => {
          this.track.scrollTo({
            left: card.offsetLeft - this.track.offsetLeft,
            behavior: 'smooth'
          });
        });

        dots.appendChild(dot);
      });
    }

    updateDots() {
      if (!this.track) return;

      const cards = [...this.track.querySelectorAll('article')];
      const dots = [
        ...this.querySelectorAll(
          '.chalhoub-carousel-{{ chalhoub_id }}__dot'
        )
      ];

      if (!cards.length || !dots.length) return;

      const trackRect = this.track.getBoundingClientRect();
      let closestIndex = 0;
      let closestDistance = Infinity;

      cards.forEach((card, index) => {
        const distance = Math.abs(
          card.getBoundingClientRect().left - trackRect.left
        );

        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      dots.forEach((dot, index) => {
        dot.setAttribute(
          'aria-current',
          index === closestIndex ? 'true' : 'false'
        );
      });
    }

    async addItem(button) {
      if (button.disabled) return;

      button.disabled = true;

      try {
        const response = await fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            id: Number(button.dataset.variantId),
            quantity: 1
          })
        });

        if (!response.ok) {
          throw new Error('Unable to add product');
        }

        const addedProduct = await response.json();

        const cartResponse = await fetch('{{ routes.cart_url }}.js', {
          headers: { 'Accept': 'application/json' }
        });

        if (!cartResponse.ok) {
          throw new Error('Unable to retrieve cart');
        }

        const cart = await cartResponse.json();

        this.querySelector('[data-modal-title]').textContent =
          button.dataset.title;

        this.querySelector('[data-modal-price]').textContent =
          button.dataset.price;

        const image = this.querySelector('[data-modal-image]');

        image.hidden = !button.dataset.image;

        if (button.dataset.image) {
          image.src = button.dataset.image;
        } else {
          image.removeAttribute('src');
        }

        const currency = '{{ cart.currency.iso_code }}';

        const formattedTotal = new Intl.NumberFormat(
          document.documentElement.lang || 'en-US',
          {
            style: 'currency',
            currency: currency
          }
        ).format(cart.total_price / 100);

        this.querySelector('[data-cart-summary]').textContent =
          'Cart: ' + cart.item_count +
          ' items · Total ' + formattedTotal;

        document.querySelectorAll(
          '[data-cart-count], .cart-count-bubble [aria-hidden="true"], .cart-count-bubble span'
        ).forEach((element) => {
          element.textContent = cart.item_count;
        });

        document.querySelectorAll('cart-icon').forEach((element) => {
          element.setAttribute('data-cart-count', cart.item_count);
        });

        document.dispatchEvent(
          new CustomEvent('cart:updated', {
            detail: {
              cart: cart,
              addedProduct: addedProduct
            }
          })
        );

        this.modal.hidden = false;

        this.querySelector(
          '.chalhoub-carousel-{{ chalhoub_id }}__dialog'
        ).focus();

      } catch (error) {
        button.textContent = 'TRY AGAIN';
      } finally {
        button.disabled = false;
      }
    }

    closeModal() {
      if (this.modal) this.modal.hidden = true;
    }
  }

  customElements.define(tagName, ChalhoubProductCarousel);
})();
</script>

{% schema %}
{
  "name": "Chalhoub Product Carousel",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "VIEW ALL"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Chalhoub Product Carousel"
    }
  ],
  "tag": null,
  "class": "chalhoub-product-carousel-block"
}
{% endschema %}